{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/config", "destination": "/api/config.js" },
    { "source": "/api/botwebhook", "destination": "/api/botwebhook.js" },
    { "source": "/api/buyitem", "destination": "/api/buyitem.js" },
    { "source": "/api/confirmdeal", "destination": "/api/confirmdeal.js" },
    { "source": "/api/deposit", "destination": "/api/deposit.js" },
    { "source": "/users/(.*)", "destination": "/profile.html?id=$1" },
    { "source": "/", "destination": "/index.html" }
  ]
}
