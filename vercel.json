{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/config.js": {
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/api/config",
      "dest": "/api/config.js"
    },
    {
      "src": "/api/(.*\\.js)",
      "dest": "/public/api/$1",
      "headers": {
        "content-type": "application/javascript"
      }
    },
    {
      "src": "/users/(.*)",
      "dest": "/public/profile.html?id=$1"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
